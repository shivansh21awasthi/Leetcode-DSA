class Solution:
    def minCost(self, grid: list[list[int]]) -> int:
        m, n = len(grid), len(grid[0])
        
        @cache
        def dfs(r, c):
            if r == m - 1 and c == n - 1:
                return {grid[r][c]}
            if r >= m or c >= n:
                return set()
            return {grid[r][c] ^ val for val in dfs(r + 1, c).union(dfs(r, c + 1))}

        return min(dfs(0, 0))
