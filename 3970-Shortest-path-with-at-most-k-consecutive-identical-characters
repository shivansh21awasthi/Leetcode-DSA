import heapq

class Solution:
    def shortestPath(self, n: int, edges: list[list[int]], labels: str, k: int) -> int:
        adj = [[] for _ in range(n)]
        for u, v, w in edges:
            adj[u].append((v, w))
            
        pq = [(0, 0, labels[0], 1)]
        visited = {}
        
        while pq:
            d, u, char, count = heapq.heappop(pq)
            
            if u == n - 1: return d
            if visited.get((u, char, count), float('inf')) <= d: continue
            visited[(u, char, count)] = d
            
            for v, w in adj[u]:
                nxt_count = (count + 1) if labels[v] == char else 1
                if nxt_count <= k:
                    heapq.heappush(pq, (d + w, v, labels[v], nxt_count))
        return -1
